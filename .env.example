# =====================================================================
# SmartSub Backend Environment Configuration
# =====================================================================
# These environment variables can be exported in your shell or set in your environment:
#
# 1. Firebase Admin SDK Service Account Credentials:
# Download from Firebase Console -> Project Settings -> Service accounts -> "Generate new private key"
# Save the JSON file securely (e.g. at backend/firebase-service-account.json)
FIREBASE_CREDENTIALS_PATH=/absolute/path/to/firebase-service-account.json

# 2. OpenAI API Key for AI Subscription Advisor & Receipt Vision Scanner:
# Obtain from https://platform.openai.com/api-keys
# (If omitted, SmartSub automatically uses its built-in rule-based intelligence engine)
OPENAI_API_KEY=sk-proj-YourActualOpenAiApiKeyHere

# 3. Optional Spring Boot / Database overrides:
# SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/smart_sub_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC
# SPRING_DATASOURCE_USERNAME=root
# SPRING_DATASOURCE_PASSWORD=your_password
